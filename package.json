{
  "name": "clipt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tauri": "tauri",
    "check": "npm run typecheck && npm run lint && cd src-tauri && cargo clippy --all-targets -- -D warnings && cargo test"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-store": "^2",
    "motion": "^14.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8",
    "vite": "^7"
  },
  "description": "A small, fast, frictionless screen recorder for macOS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardoalba00/clipt.git"
  }
}
